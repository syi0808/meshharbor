{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MeshHarbor QuadriFlow Sidecar Release Manifest",
  "description": "Strict structural schema only. Runtime validation also checks unique platforms and exact inline-bundle pins. This schema does not verify signatures, attestations, archive contents, or release approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "backend",
    "source",
    "release_tag",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "backend": {
      "const": "quadriflow"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "release_tag": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 100,
          "pattern": "^quadriflow-v[0-9][A-Za-z0-9._-]*$"
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/hjwdzh/QuadriFlow"
        },
        "commit": {
          "const": "810b7a0967c35b0dc85b4464e3835e26a756c967"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "run_id",
        "run_attempt",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "syi0808/meshharbor"
        },
        "path": {
          "const": ".github/workflows/quadriflow-candidate-build.yml"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "format",
        "url",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "filename": {
          "enum": [
            "quadriflow-linux-x86_64.tar",
            "quadriflow-macos-aarch64.tar",
            "quadriflow-windows-x86_64.tar"
          ]
        },
        "format": {
          "const": "tar"
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/syi0808/meshharbor/releases/download/quadriflow-v[0-9][A-Za-z0-9._-]*/quadriflow-(linux-x86_64|macos-aarch64|windows-x86_64)\\.tar$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        }
      }
    },
    "payload_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "third_party_notices",
        "sbom",
        "provenance",
        "provenance_signature"
      ],
      "properties": {
        "executable": {
          "allOf": [
            {
              "$ref": "#/$defs/payload_file"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "enum": [
                    "bin/quadriflow",
                    "bin/quadriflow.exe"
                  ]
                },
                "size_bytes": {
                  "maximum": 134217728
                }
              }
            }
          ]
        },
        "third_party_notices": {
          "allOf": [
            {
              "$ref": "#/$defs/payload_file"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "const": "THIRD-PARTY-NOTICES.md"
                },
                "size_bytes": {
                  "maximum": 8388608
                }
              }
            }
          ]
        },
        "sbom": {
          "allOf": [
            {
              "$ref": "#/$defs/payload_file"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "const": "sbom.spdx.json"
                },
                "size_bytes": {
                  "maximum": 16777216
                }
              }
            }
          ]
        },
        "provenance": {
          "allOf": [
            {
              "$ref": "#/$defs/payload_file"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "const": "provenance.json"
                },
                "size_bytes": {
                  "maximum": 4194304
                }
              }
            }
          ]
        },
        "provenance_signature": {
          "allOf": [
            {
              "$ref": "#/$defs/payload_file"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "const": "provenance.sigstore.json"
                },
                "size_bytes": {
                  "maximum": 262144
                }
              }
            }
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "archive",
        "workflow",
        "payload",
        "attestation_bundle_base64"
      ],
      "properties": {
        "platform": {
          "enum": [
            "linux-x86_64",
            "macos-aarch64",
            "windows-x86_64"
          ]
        },
        "archive": {
          "$ref": "#/$defs/archive"
        },
        "workflow": {
          "$ref": "#/$defs/workflow"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "attestation_bundle_base64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 349528,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "description": "Canonical base64 encoding of the exact provenance.sigstore.json bytes; runtime requires its decoded size and SHA-256 to match the payload pin."
        }
      }
    }
  }
}
