{
  "name": "@meshharbor/studio",
  "private": true,
  "version": "0.1.0",
  "license": "Elastic-2.0",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "pnpm run test:security && pnpm run test:api && node --test src/studio/preview-display.test.mjs src/studio/preview-camera.test.mjs src/studio/workbench-state.test.mjs",
    "test:security": "node --test dev-security.test.mjs",
    "test:api": "node --test src/studio/api.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:quadriflow-release": "playwright test --config playwright.quadriflow-release.config.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "radix-ui": "1.8.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-resizable-panels": "4.24.0",
    "sonner": "2.0.8",
    "three": "0.183.2",
    "vite": "7.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.183.1",
    "pngjs": "7.0.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
